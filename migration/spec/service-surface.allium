-- allium: 1
-- Glean behavioral spec — surface 6: service surface (GleanService / CLI)
-- Distilled from:
--   thrift:  glean/if/glean.thrift (GleanService ~30 methods)
--   cli:     glean/tools/gleancli/GleanCLI.hs (24 subcommands)
--   server:  glean/server/Glean/{Server,Handler}.hs (OSS: HTTP-thrift)
-- The Rust server must answer the same methods with the same results; the
-- CLI is the judge's only driver, so its behavior is parity-critical.

entity ServiceRequest { method: String, args: String }

entity ServiceResponse { request: ServiceRequest, payload: String, error: String? }

-- The public method set is closed: every thrift method maps to one handler;
-- no method may be silently dropped or added.
rule MethodSetIsClosed {
    when: req: ServiceRequest.created
    ensures:
        exists (h: ServiceResponse{request: req})
    @guidance
        -- thrift compiler generates the dispatch table from
        -- glean.thrift (build.rs in the port); drift is a compile error.
}

-- Every error carries a typed classification the client can branch on —
-- the same taxonomy for both implementations.
rule ErrorsAreClassified {
    when: resp: ServiceResponse.created
    requires: resp.error != null
    ensures: classified(resp.error)
    @guidance
        -- glass ErrorClassification table + server exception mapping
        -- (inventory EXC_TAXONOMY rows); judge asserts per-class behavior.
}

-- CLI subcommands are thin facades over the same service semantics: create,
-- write, finish, query, dump, delete, ... behave identically to their
-- thrift counterparts.
rule CliMatchesService {
    when: resp: ServiceResponse.created
    requires: resp.request.method = "userQuery"
    ensures: cli_equivalent(resp)
    @guidance
        -- Judge drives ONLY the CLI; impls.sh pins the exact templates:
        -- --db-root / --schema / create / write / finish / query with "-".
}
